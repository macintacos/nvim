#!/usr/bin/env bash
#MISE description="Type-check the Lua with emmylua_check (config in .emmyrc.json)"
#MISE depends=["deps"]

set -euo pipefail

# .emmyrc.json resolves `$VIMRUNTIME` from the environment, which only a
# running nvim sets.
VIMRUNTIME="$(nvim --clean --headless --cmd 'lua io.write(vim.env.VIMRUNTIME)' --cmd 'qa!')"
export VIMRUNTIME

emmylua_check --config .emmyrc.json --severity warn --warnings-as-errors .
